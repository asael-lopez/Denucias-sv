@model SistemasDenuncias.ViewModels.AdminLoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Acceso administrativo";
    ViewData["Css"] = "admin-login";
}
<div class="admin-login">
    <div class="admin-login-card card">

      <!-- Logo -->
      <div class="logo">
        <div class="logo-mark"><img src="~/img/valk.png" alt="Valksoya" class="logo-img"></div>
        <div><strong>SOYAPANGO</strong><small>Alcaldía Municipal</small></div>
      </div>

      <div class="admin-shield">
        <img src="~/img/valk.png" alt="" class="admin-login-logo">
      </div>

      <!-- Encabezado -->
      <div class="heading-block">
        <p class="eyebrow">PORTAL INTERNO</p>
        <h1 class="title title-1">Acceso administrativo</h1>
        <p>Ingresa con tu DUI y contraseña de administrador.</p>
      </div>

      <form class="auth-form" data-admin-login asp-controller="Account" asp-action="AdminLogin" method="post" autocomplete="on">
        @if (!string.IsNullOrEmpty(Model.Error))
        {
          <div class="notice notice-error" role="alert"><span>@Model.Error</span></div>
        }

        <label class="field">
          <span>DUI</span>
          <div class="input-wrap">
            <input type="text" name="dui" value="@Model.Dui" data-admin-dui data-dui-input placeholder="00000000-0" autocomplete="username" inputmode="numeric" pattern="[0-9]{8}-[0-9]" maxlength="10" required>
          </div>
        </label>

        <label class="field">
          <span>Contraseña</span>
          <div class="input-wrap">
            <input type="password" name="password" data-admin-password class="has-toggle" placeholder="Ingresa tu contraseña" autocomplete="current-password" maxlength="72" required>
            <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
              <svg class="icon icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12"/><circle cx="12" cy="12" r="2.5"/></svg>
              <svg class="icon icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="m3 3 18 18"/><path d="M10.6 6.2A10 10 0 0 1 12 6c6.5 0 10 6 10 6a16 16 0 0 1-3 3.8M6.3 6.3C3.5 8.2 2 12 2 12s3.5 6 10 6a9 9 0 0 0 2.3-.3"/></svg>
            </button>
          </div>
        </label>

        <button type="submit" class="btn btn-primary full" data-admin-login-submit><span>Iniciar sesión</span></button>
      </form>

      <a class="text-link" href="/login">← Volver al portal ciudadano</a>
      <small>Acceso exclusivo para personal autorizado</small>

    </div>
  </div>
