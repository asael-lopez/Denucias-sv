@model SistemasDenuncias.ViewModels.LoginPageViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
    ViewData["Css"] = "index";
}
<div class="auth-page">

    <!-- ===== Panel de marca ===== -->
    <aside class="auth-brand">
      <div class="logo">
        <div class="logo-mark"><img src="~/img/valk.png" alt="Valksoya" class="logo-img"></div>
        <div><strong>SOYAPANGO</strong><small>Alcaldía Municipal</small></div>
      </div>
      <div>
        <p class="eyebrow light">DENUNCIAS CIUDADANAS</p>
        <h1 class="title title-1">Tu voz mejora Soyapango</h1>
        <p>Reporta, consulta y da seguimiento a los casos de tu comunidad de forma fácil y segura.</p>
      </div>
      <small>Alcaldía Municipal de Soyapango · 2026</small>
    </aside>

    <!-- ===== Panel de formulario ===== -->
    <section class="auth-panel">
      <div class="auth-mobile-logo">
        <div class="logo">
          <div class="logo-mark"><img src="~/img/valk.png" alt="Valksoya" class="logo-img"></div>
          <div><strong>SOYAPANGO</strong><small>Alcaldía Municipal</small></div>
        </div>
      </div>

      <div class="auth-card">

        <!-- Pestañas -->
        <div class="tabs">
          <button type="button" class="active" data-tab="login">Iniciar sesión</button>
          <button type="button" data-tab="register">Crear cuenta</button>
        </div>

        <!-- Pestaña: Iniciar sesión -->
        <form class="auth-form" data-panel="login" asp-controller="Account" asp-action="Login" method="post" autocomplete="on">
          <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
          <div class="helding-block">
            <h1 class="title title-1">Bienvenido de nuevo</h1>
            <p>Ingresa tus datos para continuar.</p>
          </div>

          @if (!string.IsNullOrEmpty(Model.ErrorLogin))
          {
            <div class="notice notice-error" role="alert"><span>@Model.ErrorLogin</span></div>
          }
          @if (!string.IsNullOrEmpty(Model.ExitoLogin))
          {
            <div class="notice notice-success" role="status"><span>@Model.ExitoLogin</span></div>
          }

          <label class="field" data-dui-field>
            <span>DUI</span>
            <div class="input-wrap">
              <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 22c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              <input type="text" name="dui" value="@(Model.Panel == "login" ? Model.Dui : "")" data-login-dui data-dui-input placeholder="00000000-0" autocomplete="username" inputmode="numeric" pattern="[0-9]{8}-[0-9]" maxlength="10" required>
            </div>
            <small data-dui-help hidden>Usa el formato 00000000-0</small>
          </label>

          <label class="field">
            <span>Contraseña</span>
            <div class="input-wrap">
              <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
              <input type="password" name="password" data-login-password class="has-toggle" placeholder="Ingresa tu contraseña" autocomplete="current-password" maxlength="72" required>
              <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
                <svg class="icon icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12"/><circle cx="12" cy="12" r="2.5"/></svg>
                <svg class="icon icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="m3 3 18 18"/><path d="M10.6 6.2A10 10 0 0 1 12 6c6.5 0 10 6 10 6a16 16 0 0 1-3 3.8M6.3 6.3C3.5 8.2 2 12 2 12s3.5 6 10 6a9 9 0 0 0 2.3-.3"/></svg>
              </button>
            </div>
          </label>

          <button type="button" class="text-link align-right" data-show-panel="forgot">Olvidé mi contraseña</button>
          <button type="submit" class="btn btn-primary full" data-login-submit><span>Iniciar sesión</span></button>
        </form>

        <!-- Pestaña: Crear cuenta -->
        <form class="auth-form" data-panel="register" asp-controller="Account" asp-action="Registro" method="post" hidden autocomplete="off">
          <div class="heading-block">
            <h1 class="title title-1">Crea tu cuenta</h1>
            <p>Completa tus datos para empezar a reportar.</p>
          </div>

          @if (!string.IsNullOrEmpty(Model.ErrorRegistro))
          {
            <div class="notice notice-error" role="alert"><span>@Model.ErrorRegistro</span></div>
          }

          <div class="form-grid">
            <label class="field">
              <span>Nombre completo</span>
              <div class="input-wrap"><input type="text" name="nombreCompleto" value="@Model.NombreCompleto" data-register-name placeholder="Ej. María González" autocomplete="off" maxlength="120" required></div>
            </label>
            <label class="field">
              <span>DUI</span>
              <div class="input-wrap"><input type="text" name="dui" value="@(Model.Panel == "register" ? Model.Dui : "")" data-register-dui data-dui-input placeholder="00000000-0" autocomplete="off" inputmode="numeric" pattern="[0-9]{8}-[0-9]" maxlength="10" required></div>
            </label>
            <label class="field">
              <span>Correo electrónico</span>
              <div class="input-wrap"><input type="email" name="correo" value="@Model.Correo" data-register-email placeholder="correo@@ejemplo.com" autocomplete="off" maxlength="254" required></div>
            </label>
            <label class="field">
              <span>Contraseña</span>
              <div class="input-wrap">
                <input type="password" name="newPassword" data-register-password class="has-toggle" placeholder="Entre 12 y 72 caracteres" autocomplete="new-password" minlength="12" maxlength="72" required>
                <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
                  <svg class="icon icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12"/><circle cx="12" cy="12" r="2.5"/></svg>
                  <svg class="icon icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="m3 3 18 18"/><path d="M10.6 6.2A10 10 0 0 1 12 6c6.5 0 10 6 10 6a16 16 0 0 1-3 3.8M6.3 6.3C3.5 8.2 2 12 2 12s3.5 6 10 6a9 9 0 0 0 2.3-.3"/></svg>
                </button>
              </div>
            </label>
          </div>

          <label class="checkbox">
            <input type="checkbox" name="aceptaTerminos" value="true" data-register-terms required>
            <span>Acepto los términos y condiciones del portal.</span>
          </label>

          <button type="submit" class="btn btn-primary full" data-register-submit><span>Crear cuenta</span></button>
        </form>

        <form class="auth-form" data-panel="forgot" asp-controller="Account" asp-action="Recuperar" method="post" hidden>
          <div class="heading-block">
            <h1 class="title title-1">Recuperar contraseña</h1>
            <p>Escribe tu correo y te enviaremos las instrucciones para elegir una nueva contraseña.</p>
          </div>
          <label class="field">
            <span>Correo electrónico</span>
            <div class="  input-wrap"><input type="email" name="correo" data-reset-email autocomplete="email" maxlength="254" required></div>
          </label>
          @if (!string.IsNullOrEmpty(Model.ExitoRecuperar))
          {
            <div class="notice notice-success" role="status"><span>@Model.ExitoRecuperar</span></div>
          }
          @if (!string.IsNullOrEmpty(Model.EnlaceDesarrollo))
          {
            <div class="notice notice-success" role="status">
              <span>Modo desarrollo (no hay correo configurado): <a class="text-link" href="@Model.EnlaceDesarrollo">abrir enlace de recuperación</a></span>
            </div>
          }
          <button type="submit" class="btn btn-primary full" data-reset-request-submit><span>Enviar instrucciones</span></button>
          <button type="button" class="text-link" data-show-panel="login">Volver a iniciar sesión</button>
        </form>

        <!-- Acceso administrativo -->
        <div class="admin-access">¿Trabajas en la Alcaldía? <a class="text-link" href="/admin-login">Acceso administrativo</a></div>

      </div>
    </section>
  </div>

@section Scripts {
  <script>
    (function () {
      function show(name) {
        document.querySelectorAll("[data-panel]").forEach(function (p) {
          p.hidden = p.getAttribute("data-panel") !== name;
        });
        document.querySelectorAll("[data-tab]").forEach(function (t) {
          t.classList.toggle("active", t.getAttribute("data-tab") === name);
        });
      }
      document.querySelectorAll("[data-show-panel]").forEach(function (b) {
        b.addEventListener("click", function () { show(b.getAttribute("data-show-panel")); });
      });
      show("@Model.Panel");
    })();
  </script>
}
