@using SistemasDenuncias.Helpers
@{ ViewData["Nav"] = "home"; }
@{ ViewData["Title"] = "Inicio"; }
@section Styles {
  <link rel="stylesheet" href="~/css/home.css">
}
<main class="citizen-main">

    <!-- ===== Hero ===== -->
    <section class="hero-home">
      <div>
        <p class="eyebrow">MI PORTAL CIUDADANO</p>
        <h1 class="title title-1">Buenos días, @User.PrimerNombre()</h1>
        <p>¿Qué necesitas reportar hoy?</p>
      </div>
      <a class="btn btn-primary" href="/crear-denuncia">
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span>Crear denuncia</span>
      </a>
    </section>

    <!-- ===== Consultar ticket ===== -->
    <section class="ticket-search card">
      <div>
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <div>
          <h3 class="title title-3">Consultar mi ticket</h3>
          <p>Ingresa el número que recibiste al enviar tu denuncia.</p>
        </div>
      </div>
      <div class="search-row">
        <input type="text" data-ticket-search placeholder="Ej. SOY-2026-000123" autocomplete="off">
        <button type="button" class="btn btn-primary" data-ticket-search-btn><span>Consultar</span></button>
      </div>
      <p class="notice notice-error" data-ticket-search-error hidden style="margin-top:10px;"></p>
    </section>

    <!-- ===== Denuncias recientes + casos resueltos ===== -->
    <div class="content-grid">
      <section>
        <div class="section-heading">
          <div>
            <h2 class="title title-2">Mis denuncias recientes</h2>
            <p>Seguimiento de tus últimos reportes.</p>
          </div>
          <a class="text-link" href="/mis-denuncias">
            Ver todas
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m14 7 5 5-5 5"/></svg>
          </a>
        </div>

        <div class="report-cards" data-home-recent-cards>
          <!-- Se renderizan dinámicamente desde local-complaints.js -->
          <template data-home-recent-template>
            <a class="report-card" href="#">
              <div class="report-icon">
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h9l4 4v16H6z"/><path d="M14 2v5h5"/><path d="M9 13h6M9 17h6"/></svg>
              </div>
              <div>
                <strong data-home-card-type></strong>
                <span data-home-card-ticket></span>
                <small>
                  <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0"/><circle cx="12" cy="10" r="2.5"/></svg>
                  <span data-home-card-location></span>
                </small>
              </div>
              <div>
                <span class="badge" data-home-card-status><i></i><span data-home-card-status-label></span></span>
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
          </template>
          <p data-home-recent-empty hidden style="padding:16px;color:var(--muted);font-size:14px;">Aún no tienes denuncias registradas.</p>
        </div>
      </section>

      <!-- Casos resueltos -->
      <aside class="resolved card">
        <div class="resolved-head">
          <span class="success-icon">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
          </span>
          <div>
            <h3 class="title title-3">Casos resueltos en tu zona</h3>
            <p>Esta semana</p>
          </div>
        </div>
        <strong>18</strong>
        <p>reportes atendidos cerca de Las Margaritas</p>
        <div class="mini-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </aside>
    </div>

    <!-- ===== Aviso de ayuda ===== -->
    <section class="callout card">
      <div class="call-icon">
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4a2 2 0 0 0-2 2c0 9.4 7.6 17 17 17a2 2 0 0 0 2-2v-3l-4-1-2 3c-4.3-1.5-7.5-4.7-9-9l3-2z"/></svg>
      </div>
      <div>
        <h3 class="title title-3">¿Necesitas ayuda inmediata?</h3>
        <p>Llámanos de lunes a viernes, de 8:00 a.m. a 4:00 p.m.</p>
        <small>Disponible solo en horario de atención</small>
      </div>
      <button type="button" class="btn btn-secondary" disabled>
        <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3H4a2 2 0 0 0-2 2c0 9.4 7.6 17 17 17a2 2 0 0 0 2-2v-3l-4-1-2 3c-4.3-1.5-7.5-4.7-9-9l3-2z"/></svg>
        <span>Llamar a la Alcaldía</span>
      </button>
    </section>

  </main>

@section Scripts {
  <script src="~/js/local-complaints.js"></script>
}
